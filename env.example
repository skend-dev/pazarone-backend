# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=pazaro_db
# Set to true if your host requires TLS (many cloud / Railway public Postgres URLs)
# DATABASE_SSL=true

# JWT Configuration
# IMPORTANT: Generate strong random secrets for production (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend URL (used for password reset links, affiliate links, etc.)
FRONTEND_URL=http://localhost:3000

# SendGrid Email Configuration (optional but recommended)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@pazarone.co
SENDGRID_FROM_NAME=PazarOne
SENDGRID_REPLY_TO_EMAIL=support@pazarone.co
# Marketing & announcements (broadcast emails) - from/reply-to for admin broadcast
SENDGRID_MARKETING_FROM_EMAIL=hello@pazarone.co
SENDGRID_MARKETING_FROM_NAME=PazarOne Marketing

# Infobip People (Customer Profiles) — push phone contacts for SMS/Viber inside Infobip
# https://www.infobip.com/docs/api/customer-engagement/people
# When SYNC_ENABLED=true, users with phones are upserted after sync and CSV imports; use admin “batch push” too.
INFOBIP_PEOPLE_SYNC_ENABLED=false
INFOBIP_PEOPLE_BASE_URL=https://api.infobip.com
INFOBIP_PEOPLE_API_KEY=
# Optional fallback if INFOBIP_PEOPLE_API_KEY is unset (same Infobip App key works for People on many accounts).
# INFOBIP_VIBER_API_KEY=

INFOBIP_PEOPLE_UPSERT_PATH=/people/2/persons

# People LIST (pull Infobip → Audience; POST …/admin/marketing/contacts/import-from-infobip)
INFOBIP_PEOPLE_LIST_PATH=/people/2/persons
# INFOBIP_PEOPLE_LIST_PAGE_QUERY=page
# INFOBIP_PEOPLE_LIST_LIMIT_QUERY=limit
# INFOBIP_PEOPLE_LIST_PAGE_ZERO_INDEXED=false
INFOBIP_PEOPLE_LIST_TIMEOUT_MS=60000

# Webhooks — Infobip Viber BM (DLR + incoming HTTP). When INFOBIP_WEBHOOK_SECRET is set, require one of:
#   Authorization: Bearer <secret>
#   X-Infobip-Webhook-Secret: <secret>
#   Query ?token=<secret>   (typical in Infobip portal URL fields)
# Primary URLs (match Infobip “DLR forwarding” and “Forward to HTTP”):
#   POST {BACKEND}/api/webhooks/infobip/viber/delivery?token=<secret>
#   POST {BACKEND}/api/webhooks/infobip/viber/incoming?token=<secret>
# Legacy aliases: …/delivery-reports, …/inbound
# INFOBIP_WEBHOOK_SECRET=

# Email Logo URL (optional - URL to your logo image, e.g., Cloudinary CDN URL)
# Recommended: Upload logo to Cloudinary and use the CDN URL
# Size: 180px width, PNG format (with transparency if needed)
EMAIL_LOGO_URL=https://res.cloudinary.com/dprvz8sh0/image/upload/v1768900682/logo_es18qw.png

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional: Cloudinary folder for uploads (defaults to 'products')
CLOUDINARY_FOLDER=products

# Telegram Bot Configuration (optional - for seller order notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Admin User Configuration (optional - for seeding super admin)
ADMIN_EMAIL=admin@pazarone.co
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Firebase Admin SDK (optional - for Sign in with Google/Apple)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key from JSON - use actual newlines or \n escaped in .env (here we show escaped)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
